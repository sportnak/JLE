  "factSheet": {
    "status": "draft",
    "body": "い-adjectives end in い and change form themselves: 高い → 高くない (not expensive), 高かった (was expensive). Before a noun they stay as they are: 高い本. いい is irregular: よくない, よかった."
  },
  "contrasts": [
    {
      "sentence": "昨日は寒＿です。",
      "answer": "かった",
      "other": "でした",
      "translation": "It was cold yesterday."
    },
    {
      "sentence": "この本は高＿です。",
      "answer": "くない",
      "other": "じゃない",
      "translation": "This book is not expensive."
    }
  ]
}

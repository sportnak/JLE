  "factSheet": {
    "status": "draft",
    "body": "The て-form links actions in order (起きて、顔を洗います: I get up and wash my face) and with ください makes a request (窓を開けてください: please open the window). う, つ, る verbs → って; む, ぶ, ぬ → んで; く → いて; ぐ → いで; す → して. 行く is irregular: 行って."
  },
  "contrasts": [
    {
      "sentence": "窓を開け＿ください。",
      "answer": "て",
      "other": "た",
      "translation": "Please open the window."
    },
    {
      "sentence": "ここで待っ＿ください。",
      "answer": "て",
      "other": "た",
      "translation": "Please wait here."
    }
  ]
}

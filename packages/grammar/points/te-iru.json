  "factSheet": {
    "status": "draft",
    "body": "Verb in the て-form + いる means an action in progress (今、本を読んでいます: I am reading a book now) or a resulting state (結婚しています: is married; 東京に住んでいます: lives in Tokyo)."
  },
  "contrasts": [
    {
      "sentence": "今、雨が降って＿。",
      "answer": "います",
      "other": "あります",
      "translation": "It is raining now."
    }
  ]
}
